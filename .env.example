# --- Основні налаштування Django ---
# УВАГА: у продакшені DEBUG обов'язково має бути False!
DEBUG=False
SECRET_KEY=замініть-на-довгий-випадковий-секретний-ключ-мінімум-50-символів
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://example.if.ua
# Базова адреса сайту без слеша в кінці (для локальної розробки — http://127.0.0.1:8000, на сервері — https://ДОМЕН)
SITE_URL=http://127.0.0.1:8000

# --- База даних PostgreSQL ---
DB_NAME=oberih_db
DB_USER=oberih_user
DB_PASSWORD=замініть-на-надійний-пароль-бд
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Шляхи до статики та медіафайлів (PDF, фото) ---
# Можна вказати абсолютні шляхи на сервері для легкого переїзду на інший хостинг
STATIC_ROOT=staticfiles
MEDIA_ROOT=media
# Роздача /media/ засобами Django (при DEBUG=False):
# - На Render (PaaS без окремого Nginx): поставте SERVE_MEDIA=True
# - На VPS, коли Nginx сам віддає /media/: залиште SERVE_MEDIA=False
SERVE_MEDIA=False
# Максимальна дозволена кількість пікселів у фото (за замовчуванням 50000000 = 50 МП)
IMAGE_MAX_PIXELS=50000000

# --- Налаштування пошти (для сповіщень та форми звернень) ---
# Для локальної перевірки без SMTP-сервера вкажіть:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@oberih.if.ua
EMAIL_HOST_PASSWORD=замініть-на-пароль-пошти
# Таймаут очікування відповіді від поштового сервера в секундах (щоб не блокувати воркер Gunicorn)
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@oberih.if.ua
# Пошта для отримання звернень із форми «Поставити запитання» (якщо порожньо — береться з налаштувань сайту в БД)
CONTACT_NOTIFY_EMAIL=

# --- Ліміти запитів (форма звернень та вхід в адмінку) і reverse-proxy ---
# Максимум звернень із форми з однієї адреси за вказаний період (у секундах)
CONTACT_RATE_LIMIT_COUNT=3
CONTACT_RATE_LIMIT_PERIOD=600
# Ліміт невдалих спроб входу в адмінку: 5 на пару (адреса + логін) та 20 загалом з адреси за 900 с (15 хв)
ADMIN_LOGIN_RATE_LIMIT_COUNT=5
ADMIN_LOGIN_IP_RATE_LIMIT_COUNT=20
ADMIN_LOGIN_RATE_LIMIT_PERIOD=900
# Визначення адреси клієнта за проксі / балансувальником:
# - Для PaaS (наприклад Render): вкажіть CLIENT_IP_HEADER=HTTP_TRUE_CLIENT_IP, а TRUST_X_FORWARDED_FOR=False
# - Для VPS за власним Nginx: залиште CLIENT_IP_HEADER порожнім і увімкніть TRUST_X_FORWARDED_FOR=True
#   (при порожньому CLIENT_IP_HEADER бекенд бере останній запис із заголовка X-Forwarded-For).
CLIENT_IP_HEADER=
TRUST_X_FORWARDED_FOR=False

# --- Налаштування HTTPS, проксі, сесії та CSP ---
# Для локальної розробки без HTTPS поставте SESSION_COOKIE_SECURE=False, CSRF_COOKIE_SECURE=False,
# SECURE_SSL_REDIRECT=False та SECURE_HSTS_SECONDS=0.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_AGE=28800
# УВАГА: на сервері за Nginx або на PaaS ОБОВ'ЯЗКОВО увімкніть USE_X_FORWARDED_PROTO=True!
# Без цього при увімкненому SECURE_SSL_REDIRECT=True виникне нескінченний цикл перенаправлень (redirect loop),
# оскільки Gunicorn отримує від Nginx внутрішній HTTP-запит і знає про HTTPS лише із заголовка X-Forwarded-Proto.
USE_X_FORWARDED_PROTO=False
SECURE_SSL_REDIRECT=True
# Починайте з невеликого значення HSTS (наприклад 3600 = 1 година), а після перевірки роботи HTTPS збільшіть до 31536000 (1 рік)
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Заголовок Content-Security-Policy для публічних сторінок сайту
CSP_ENABLED=True

# --- Журналювання та резервне копіювання ---
# Шлях до файлу журналу з автоматичною ротацією (порожньо — вивід лише в консоль / systemd journal)
LOG_FILE=logs/oberih.log
LOG_LEVEL=INFO
# Каталог для резервних копій (ОБОВ'ЯЗКОВО поза каталогом проєкту та поза MEDIA_ROOT!)
BACKUP_DIR=../oberih_backups
BACKUP_KEEP_COUNT=7
